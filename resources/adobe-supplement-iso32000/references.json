    },
    {
      "title": "qpdf PDF Encryption documentation",
      "url": "https://qpdf.readthedocs.io/en/stable/encryption.html",
      "locator": "Relationship between R and V, R=5 row",
      "details": "Revision 5 is retained for compatibility testing. It must not be presented as a recommended modern document security default."
    },
    {
      "title": "NIST SP 800-38A block-cipher modes",
      "url": "https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nistspecialpublication800-38a.pdf",
      "locator": "Appendices F.1.5 and F.2.5",
      "details": "Independent published ECB-AES256 and CBC-AES256 known-answer blocks used in the cryptographic backend tests. This is vector validation, not cryptographic-module certification."
    },
    {
      "title": "RFC 3454 Stringprep tables and bidirectional checks",
      "url": "https://www.rfc-editor.org/rfc/rfc3454.txt",
      "locator": "Section 6 and appendices A–D",
      "details": "The fixed Unicode 3.2 unassigned, mapping, prohibited and bidirectional tables underpin historical R=5 SASLprep rather than the runtime Unicode version."
    },
    {
      "title": "RFC 4013 verified erratum 1812",
      "url": "https://errata.rfc-editor.org/eid1812/",
      "locator": "Section 2.3",
      "details": "The prohibited-character requirement applies to output after mapping and normalization."
    },
    {
      "title": "ISO legacy password padding inherited by the supplement",
      "source": {
        "document": "iso32000-1-2008",
        "filename": "PDF32000_2008.pdf",
        "sha256": "2dc784890e65da6c324d46ece182fb4705b751e49587b1bbe9c3225c25fed4d3",
        "pdfPages": [
          69,
          70
        ],
        "clause": "7.6.3.3, Algorithm 2"
      },
      "details": "The supplement step 1 wording does not repeat the mandatory 32-byte padding/truncation. Four independent qpdf-derived keys confirm retaining the ISO rule."
    },
    {
      "title": "ISO ordered public-key digest inputs",
      "source": {
        "document": "iso32000-1-2008",
        "filename": "PDF32000_2008.pdf",
        "sha256": "2dc784890e65da6c324d46ece182fb4705b751e49587b1bbe9c3225c25fed4d3",
        "pdfPages": [
          74,
          75
        ],
        "clause": "7.6.4.3"
      },
      "details": "The supplement replaces SHA-1 with SHA-256 for 256-bit keys. The inherited ordered inputs are the 20-byte seed, encoded recipient envelopes and optional clear-metadata suffix; a digest primitive does not implement CMS."
    }
