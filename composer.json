{
    "name": "roukmoute/pdf",
    "type": "library",
    "description": "Explicit PDF 1.7 and PDF 2.0 objects and writing, with modern signatures, AES-GCM, PDF MAC, metadata and tagged-structure validation",
    "keywords": [
        "pdf",
        "pdf-1.7",
        "pdf-2.0",
        "iso-32000-1",
        "iso-32000-2",
        "object-model",
        "php",
        "tagged-pdf",
        "xmp",
        "aes-gcm",
        "pdf-mac"
    ],
    "homepage": "https://pdftoolkit.github.io/modules/core/",
    "support": {
        "docs": "https://pdftoolkit.github.io/modules/core/",
        "issues": "https://github.com/PDFToolkit/pdf/issues",
        "source": "https://github.com/PDFToolkit/pdf"
    },
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-zlib": "*",
        "php-64bit": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "pdftoolkit/pdf-fonts": "^0.1.8",
        "pdftoolkit/pdf-images": "^0.1.8",
        "pdftoolkit/pdf-reader": "^0.1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-openssl": "Required only for explicitly selected AES and CMS encryption or signature backends."
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mathias STRASSER",
            "email": "contact@roukmoute.fr"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "PDF\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDF\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@test",
            "@analyse",
            "@format:check"
        ],
        "example": "@php examples/hello-world.php"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.7.x-dev"
        }
    }
}
