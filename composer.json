{
    "name": "roukmoute/pdf",
    "type": "library",
    "description": "An explicit object model and writer for ISO 32000-1 PDF 1.7",
    "require": {
        "php": "^8.5",
        "ext-iconv": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.1"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mathias STRASSER",
            "email": "contact@roukmoute.fr"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "PDF\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDF\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "check": ["@test", "@analyse", "@format:check"],
        "example": "@php examples/hello-world.php"
    }
}
